{
  "name": "@aorizondo/lowcoder-mcp-server",
  "version": "0.4.2",
  "description": "MCP Server para que agentes de IA (Claude, Cursor, etc.) creen aplicaciones Lowcoder via Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "lowcoder-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js 2>/dev/null || true",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aorizondo/lowcoder-agent-sdk-core": "^0.3.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "lowcoder",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "claude",
    "cursor",
    "low-code"
  ],
  "author": {
    "name": "Antonio Orizondo Leyva",
    "email": "aorizondoleyva@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aorizondo/lowcoder-agent-sdk.git",
    "directory": "packages/mcp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
