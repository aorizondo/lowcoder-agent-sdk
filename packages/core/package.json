{
  "name": "@aorizondo/lowcoder-agent-sdk-core",
  "version": "0.4.2",
  "description": "SDK TypeScript para crear aplicaciones Lowcoder desde código. Convierte llamadas fluent en el JSON DSL correcto que Lowcoder acepta, sin que el usuario tenga que conocer la estructura interna.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "npm run build",
    "test:dsl": "node dist/test/basic.js"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "lowcoder",
    "low-code",
    "sdk",
    "dsl",
    "dashboard",
    "agent",
    "ai",
    "code-generation"
  ],
  "author": {
    "name": "Antonio Orizondo Leyva",
    "email": "aorizondoleyva@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aorizondo/lowcoder-agent-sdk.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
